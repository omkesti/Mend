# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub personal access token with repo scope
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Async SQLAlchemy database URL
DATABASE_URL=sqlite+aiosqlite:///./cicd_agent.db

# Max CI healing loop iterations before giving up
MAX_RETRIES=5

# Per-command subprocess timeout, in seconds
SANDBOX_TIMEOUT=120

# Directory where repos are cloned and operated on
WORKSPACE_DIR=/tmp/cicd_agent_workspaces

# Claude model id
MODEL=claude-sonnet-4-6
